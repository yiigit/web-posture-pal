# Copy to .env and set a random token of at least 32 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTUREPAL_ADMIN_TOKEN=

# Set true when serving over HTTPS outside localhost.
POSTUREPAL_SECURE_COOKIES=false

# MySQL application and root passwords must be different random values.
MYSQL_DATABASE=posturepal
MYSQL_USER=posturepal
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Optional: set a unique 12–128 character demo password before running the seed command.
POSTUREPAL_DEMO_PASSWORD=
# Local connections can use MYSQL_HOST=127.0.0.1 and MYSQL_PORT=3306.
